# database
DATABASE_URL=postgresql://
# used by docker-compose.yml (required, no default)
POSTGRES_PASSWORD=
# optional default for `pnpm db:seed:admin` (or pass the email as an argument)
ADMIN_EMAIL=

# better-auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# google oauth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# github oauth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
VITE_GITHUB_CLIENT_ID=

# meilisearch
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=
MEILI_SEARCH_KEY=

# elysia api (standalone backend on its own port)
API_URL=http://localhost:3002
API_PORT=3002
WEBHOOK_SECRET=generate-with-openssl-rand-base64-32
VITE_API_URL=http://localhost:3002
# sse limits (optional); per-client limit only applies when TRUST_PROXY=true
SSE_MAX_CONNECTIONS=500
SSE_MAX_CONNECTIONS_PER_IP=5
TRUST_PROXY=false

# quackback feedback widget (optional — widget is disabled when unset)
VITE_QUACKBACK_WIDGET_KEY=
