# database
DATABASE_URL=postgresql://
# used by docker-compose.yml (required, no default)
POSTGRES_PASSWORD=
# optional default for `pnpm db:seed:admin` (or pass the email as an argument)
ADMIN_EMAIL=

# better-auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# web ports
# PORT is the port the app listens on, shared by vite dev and nitro prod.
# WEB_PORT is the host port docker publishes for that container; it only
# affects the compose stack. Keep them equal so the stack matches `pnpm dev`.
PORT=3000
WEB_PORT=3000

# google oauth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# github oauth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
VITE_GITHUB_CLIENT_ID=

# meilisearch
# MEILI_MASTER_KEY is yours to choose and must be at least 16 bytes; the
# container boots with it, so it can be generated freely.
# MEILI_SEARCH_KEY must be a key Meilisearch has actually issued, so it cannot
# be pre-generated. Start the stack, then mint one and paste it back here:
#   curl -X POST http://localhost:7700/keys \
#     -H "Authorization: Bearer $MEILI_MASTER_KEY" \
#     -H "Content-Type: application/json" \
#     -d '{"name":"search","actions":["search"],"indexes":["*"]}'
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=
MEILI_SEARCH_KEY=
# key scoped to documents.add/documents.delete on the "projects" index; the
# web app uses it to keep search in sync (docs/search/meilisearch.md)
MEILI_ADMIN_KEY=

# elysia api (standalone backend on its own port)
API_URL=http://localhost:3002
API_PORT=3002
WEBHOOK_SECRET=generate-with-openssl-rand-base64-32
VITE_API_URL=http://localhost:3002
# sse limits (optional); per-client limit only applies when TRUST_PROXY=true
SSE_MAX_CONNECTIONS=500
SSE_MAX_CONNECTIONS_PER_IP=5
TRUST_PROXY=false

# cloudflare turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# The values below are Cloudflare's public always-pass TEST keys, which only
# work outside production. For a deployed environment use the real widget's
# site key and secret, and set TURNSTILE_HOSTNAMES to that deployment's exact
# frontend hostnames (never localhost or 127.0.0.1 in production).
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# object storage (S3 API). Local development uses Garage from
# docker-compose.yml; run `just storage-init` after the first start.
# Production uses Cloudflare R2: STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com,
# STORAGE_REGION=auto, STORAGE_FORCE_PATH_STYLE=false, and STORAGE_PUBLIC_URL
# set to the bucket's custom domain.
# Generate: GARAGE_RPC_SECRET=`openssl rand -hex 32`,
# STORAGE_ACCESS_KEY_ID=GK + `openssl rand -hex 12`,
# STORAGE_SECRET_ACCESS_KEY=`openssl rand -hex 32`
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
STORAGE_ENDPOINT=http://localhost:3900
STORAGE_REGION=garage
STORAGE_BUCKET=voxelvein-dev
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=true
# optional: public base URL for downloads (R2 custom domain). When unset,
# downloads use short-lived presigned URLs.
STORAGE_PUBLIC_URL=
# optional: upload size limit in bytes (default 104857600 = 100 MB)
STORAGE_MAX_FILE_BYTES=
# optional: total bytes all uploaded files may use; uploads that would go
# over it are refused (507). 9500000000 keeps you under R2's free 10 GB.
STORAGE_QUOTA_BYTES=
