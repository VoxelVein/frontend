{
  "name": "voxelvein-frontend",
  "version": "ALPHA-0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:all",
    "dev:web": "vite dev",
    "dev:api": "tsx watch server/index.ts",
    "dev:all": "concurrently -n app,api -c blue,green \"pnpm dev:web\" \"pnpm dev:api\"",
    "start:api": "tsx server/index.ts",
    "send:webhook": "tsx scripts/send-webhook.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "check:bundle": "tsx scripts/check-bundle-size.ts",
    "db:seed": "node scripts/seed-mods.ts",
    "db:seed:admin": "tsx scripts/seed-admin.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "lint": "oxlint",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "format": "oxfmt --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "ultracite check",
    "typecheck": "tsc --noEmit",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@better-auth/passkey": "^1.7.3",
    "@elysia/cors": "^1.4.2",
    "@elysia/node": "^1.4.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@lonik/themer": "^0.5.4",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/charts": "^0.18.0",
    "@tanstack/markdown": "^0.0.13",
    "@tanstack/react-charts": "^0.18.0",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-virtual": "^3.14.11",
    "@tanstack/router-plugin": "latest",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.4",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.30",
    "envin": "^1.2.0",
    "meilisearch": "^0.60.0",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260903-beta",
    "pg": "^8.23.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.20.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@github/markdownlint-github": "^0.8.3",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "@vitest/coverage-v8": "^5.0.0",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint-plugin-sonarjs": "^4.2.0",
    "husky": "^9.1.7",
    "jsdom": "^30",
    "markdown-it": "^15.0.1",
    "markdownlint-cli2": "^0.23.2",
    "markdownlint-cli2-formatter-pretty": "^0.0.10",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-plugin-react-doctor": "^0.9.13",
    "tsx": "^4.23.13",
    "typescript": "^7",
    "ultracite": "7.10.7",
    "vite": "^8",
    "vitest": "^5"
  },
  "packageManager": "pnpm@11.3.0"
}
