{
  "name": "voxelvein-frontend",
  "version": "ALPHA-0.10.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:all",
    "dev:web": "vite dev",
    "dev:api": "tsx watch server/index.ts",
    "dev:all": "pnpm run \"/^dev:(web|api)$/\"",
    "start:api": "tsx server/index.ts",
    "send:webhook": "tsx scripts/send-webhook.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "check:bundle": "tsx scripts/check-bundle-size.ts",
    "db:seed": "tsx scripts/seed-projects.ts",
    "db:reindex": "tsx scripts/seed-projects.ts --reindex",
    "db:reindex:posts": "tsx scripts/reindex-posts.ts",
    "db:seed:admin": "tsx scripts/seed-admin.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "storage:init": "./scripts/garage-init.sh",
    "lint": "oxlint",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "format": "oxfmt --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "ultracite check",
    "typecheck": "tsc --noEmit",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/lib-storage": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "^1.7.6",
    "@better-auth/passkey": "^1.7.6",
    "@elysia/cors": "^1.4.2",
    "@elysia/node": "^1.4.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@lonik/themer": "^0.5.4",
    "@tabler/icons-react": "^3.48.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/charts": "^0.18.0",
    "@tanstack/markdown": "^0.0.15",
    "@tanstack/react-charts": "^0.18.0",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-virtual": "^3.14.13",
    "@tanstack/router-plugin": "latest",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dotenv": "^18.0.3",
    "drizzle-orm": "^0.45.3",
    "elysia": "^1.4.30",
    "envin": "^1.3.0",
    "exact-mirror": "^0.2.7",
    "meilisearch": "^0.62.0",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260903-beta",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@github/markdownlint-github": "^0.8.4",
    "@opencode/plugin": "2.0.18",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "drizzle-kit": "^0.31.11",
    "eslint-plugin-sonarjs": "^4.2.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "markdown-it": "^15.0.2",
    "markdownlint-cli2": "^0.23.3",
    "markdownlint-cli2-formatter-pretty": "^0.0.10",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-plugin-react-doctor": "^0.9.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "ultracite": "7.12.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@11.3.0"
}
